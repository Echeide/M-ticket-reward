{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtales-ticket-rewards-admin",
  "account_id": "bd9673fa93df62e1a3a36eda18bb3250",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "r2_buckets": [
    {
      "binding": "TICKETS",
      "bucket_name": "rtales-ticket-receipts"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rtales-ticket-rewards",
      "database_id": "e2523d3b-c7ba-407e-81a2-6a52646f29bc",
      "migrations_dir": "migrations-d1"
    }
  ],
  "images": { "binding": "IMAGES" },
  "queues": {
    "producers": [
      { "binding": "JOBS", "queue": "rtales-ticket-jobs" }
    ]
  },
  "vars": {
    "ADMIN_ONLY": "true",
    "RTALES_BASE_URL": "https://rtales.app",
    "RTALES_PARENT_ORIGINS": "'none'",
    "OCR_PROVIDER": "workers-ai",
    "OCR_MODEL": "@cf/moondream/moondream3.1-9B-A2B",
    "OCR_WORKERS_AI_FORMAT": "moondream",
    "OCR_MODE": "workers-ai",
    "OCR_TIMEOUT_MS": "45000",
    "ALLOW_DEV_ADMIN": "false",
    "MAX_TICKET_BYTES": "10485760"
  }
}
