{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rtales-ticket-rewards",
  "account_id": "bd9673fa93df62e1a3a36eda18bb3250",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "TICKETS",
      "bucket_name": "rtales-ticket-receipts"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rtales-ticket-rewards",
      "database_id": "e2523d3b-c7ba-407e-81a2-6a52646f29bc",
      "migrations_dir": "migrations-d1"
    }
  ],
  "ai": { "binding": "AI" },
  "images": { "binding": "IMAGES" },
  "queues": {
    "producers": [
      { "binding": "OCR_JOBS", "queue": "rtales-ticket-ocr-jobs" },
      { "binding": "REWARD_JOBS", "queue": "rtales-ticket-reward-jobs" }
    ],
    "consumers": [
      {
        "queue": "rtales-ticket-ocr-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 3,
        "max_concurrency": 35,
        "dead_letter_queue": "rtales-ticket-ocr-jobs-dlq"
      },
      {
        "queue": "rtales-ticket-reward-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 8,
        "max_concurrency": 20,
        "dead_letter_queue": "rtales-ticket-reward-jobs-dlq"
      },
      {
        "queue": "rtales-ticket-jobs",
        "max_batch_size": 1,
        "max_batch_timeout": 0,
        "max_retries": 8,
        "dead_letter_queue": "rtales-ticket-jobs-dlq"
      }
    ]
  },
  "triggers": { "crons": ["*/2 * * * *"] },
  "vars": {
    "RTALES_BASE_URL": "https://rtales.app",
    "RTALES_PARENT_ORIGINS": "https://rtales.app,https://echeide.rtales.app,https://gcx26.rtales.app",
    "RTALES_TIMEOUT_MS": "10000",
    "RTALES_REWARD_MAX_ATTEMPTS": "8",
    "OCR_PROVIDER": "workers-ai",
    "OCR_MODEL": "@cf/meta/llama-3.2-11b-vision-instruct",
    "OCR_WORKERS_AI_FORMAT": "chat",
    "OCR_MODE": "workers-ai",
    "OCR_TIMEOUT_MS": "45000",
    "OCR_MAX_ATTEMPTS": "3",
    "ALLOW_DEV_ADMIN": "false",
    "MAX_TICKET_BYTES": "10485760"
  }
}
